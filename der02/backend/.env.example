DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=yourpassword
DB_NAME=der02_db

# Google Gemini (AI safety suggestions). Server-side only -- this key is read
# by the backend and never sent to the browser. The feature degrades to a
# plain "not configured" message when it is absent.
GEMINI_API_KEY=your_key_here
# Optional: override the model if Google retires the default.
GEMINI_MODEL=gemini-1.5-flash
